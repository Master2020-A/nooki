usar tensor

funcion principal() -> entero {
    variable a = tensor.ceros(2, 2)
    tensor.poner(a, 0, 0, 1)
    tensor.poner(a, 0, 1, 2)
    tensor.poner(a, 1, 0, 3)
    tensor.poner(a, 1, 1, 4)

    imprimir(tensor.minimo(a))
    imprimir(tensor.maximo(a))
    imprimir(tensor.media(a))
    imprimir(tensor.varianza(a))
    imprimir(tensor.desviacion(a))

    variable n = tensor.normalizar(a)
    imprimir(tensor.leer(n, 0, 0))
    imprimir(tensor.leer(n, 1, 1))

    variable r = tensor.relu(a)
    imprimir(tensor.leer(r, 0, 0))

    variable s = tensor.sigmoides(a)
    imprimir(tensor.leer(s, 0, 0))
    imprimir(tensor.leer(s, 1, 1))

    variable x = tensor.ceros(1, 3)
    tensor.poner(x, 0, 0, 1)
    tensor.poner(x, 0, 1, 2)
    tensor.poner(x, 0, 2, 3)
    variable sm = tensor.softmax(x)
    imprimir(tensor.leer(sm, 0, 0))
    imprimir(tensor.leer(sm, 0, 1))
    imprimir(tensor.leer(sm, 0, 2))
    imprimir(tensor.suma_total(sm))

    tensor.liberar(a)
    tensor.liberar(n)
    tensor.liberar(r)
    tensor.liberar(s)
    tensor.liberar(x)
    tensor.liberar(sm)
    retornar 0
}
