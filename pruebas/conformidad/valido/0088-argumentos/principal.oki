// Los argumentos del programa: sin argumentos, la lista está vacía.
usar sistema
usar textos

funcion principal() -> entero {
    imprimir(textos.de_entero(sistema.cuantos_argumentos()))
    imprimir(textos.de_entero(sistema.argumentos().largo()))

    variable primero = sistema.argumento(0)
    imprimir(textos.de_entero(primero.largo()))
    retornar 0
}
