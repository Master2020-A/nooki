// Prestar el resultado de una llamada, sin guardarlo antes en una variable.
usar csv
usar archivo

funcion nombre() -> texto {
    retornar "Ana" + ""
}

funcion saludar(quien: &texto) -> vacio {
    imprimir("Hola, " + *quien)
}

funcion doble(n: entero) -> entero {
    retornar n * 2
}

funcion principal() -> entero {
    // Un texto devuelto por una función.
    saludar(&nombre())

    // Un entero devuelto por una función, prestado a otra que lo lee.
    variable caja = Caja<entero>.nuevo(doble(21))
    imprimir(caja.sacar())

    // Y un campo de una colección, que es el caso que estorbaba al leer CSV.
    variable ruta = "prestamo.csv" + ""
    variable contenido = "a;1,5\nb;2,5\n" + ""
    variable escrito = archivo.escribir(&ruta, &contenido)
    variable filas = csv.filas(&ruta)
    variable punto_coma = ";" + ""
    variable fila = filas.obtener(1)
    variable campos = csv.campos_con(&fila, &punto_coma)
    imprimir(csv.a_numero(&campos.obtener(1)))
    retornar 0
}
