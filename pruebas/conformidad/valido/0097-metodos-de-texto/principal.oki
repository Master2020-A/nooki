// El resultado de un método de texto conserva su tipo: se puede comparar y usar
// como texto sin pasar por una variable intermedia con el tipo escrito.
//
// Antes esto no compilaba: `pieza` se quedaba sin tipo y `pieza == "a"` daba
// «se esperaba un valor de tipo entero».
usar textos

funcion primera_letra(valor: &texto) -> texto {
    retornar valor.subtexto(0, 1)
}

funcion es_eme(valor: &texto) -> booleano {
    variable letra = valor.subtexto(0, 1)
    retornar letra == "m"
}

funcion principal() -> entero {
    variable palabra = "mesa" + ""
    imprimir(primera_letra(&palabra))

    si (es_eme(&palabra)) {
        imprimir("empieza por m")
    }

    // Y encadenado: subtexto y mayúsculas.
    variable arriba = palabra.subtexto(0, 2).mayusculas()
    imprimir(arriba)

    // El largo de un recorte también es un entero.
    imprimir(textos.de_entero(palabra.subtexto(1, 3).largo()))
    retornar 0
}
