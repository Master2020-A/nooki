// Guardar y cargar la red de varias clases: vuelven los pesos y las muestras.
usar redes

funcion clase_de(x: flotante, y: flotante) -> entero {
    si (y < x - 0.3) {
        retornar 0
    }
    si (y > x + 0.3) {
        retornar 1
    }
    retornar 2
}

funcion principal() -> entero {
    variable red = redes.nueva_clases(2, 12, 3)

    variable i = 0
    mientras (i < 9) {
        variable j = 0
        mientras (j < 9) {
            variable x = (i como flotante - 4.0) / 4.0
            variable y = (j como flotante - 4.0) / 4.0
            redes.ejemplo_clase(red, x, y, 0.0, 0.0, clase_de(x, y))
            j = j + 1
        }
        i = i + 1
    }
    redes.entrenar_clases(red, 3000, 0.5)

    variable archivo = "clases_conformidad.modelo" + ""
    si (!redes.guardar_clase(red, &archivo)) {
        imprimir("no se pudo guardar")
        retornar 1
    }

    variable copia = redes.cargar_clase(&archivo)
    si (copia == 0) {
        imprimir("no se pudo cargar")
        retornar 1
    }

    // Vuelven las muestras y los aciertos.
    imprimir(redes.total_clase(copia))
    imprimir(redes.aciertos_clase(copia))

    // Y predice lo mismo que la original.
    variable antes = redes.predecir_clase(red, 0.5, 0.5, 0.0, 0.0)
    variable despues = redes.predecir_clase(copia, 0.5, 0.5, 0.0, 0.0)
    si (antes == despues) {
        imprimir("igual")
    }

    // Un archivo de la red binaria no vale para esta: se rechaza.
    variable otro = "no_existe.modelo" + ""
    si (redes.cargar_clase(&otro) == 0) {
        imprimir("archivo ajeno rechazado")
    }

    redes.liberar_clase(copia)
    redes.liberar_clase(red)
    retornar 0
}
