// Un vector de fichas con texto.
//
// El texto que se mete en el compuesto **se mueve**: la variable deja de tenerlo,
// así que aquí cada ficha se construye con su propia copia y no se reutiliza.
estructura ficha {
    publico nombre: texto
    publico edad: entero
}

funcion principal() -> entero {
    variable lista = Vector<ficha>.nuevo()

    lista.agregar(ficha { nombre: "Ana" + "", edad: 30 })
    lista.agregar(ficha { nombre: "Luis" + "", edad: 25 })

    imprimir(lista.largo())

    variable primera = lista.obtener(0)
    imprimir(primera.nombre)
    imprimir(primera.edad)

    // Cambiar un elemento: el vector libera el nombre viejo.
    lista.modificar(1, ficha { nombre: "Pepe" + "", edad: 40 })
    variable segunda = lista.obtener(1)
    imprimir(segunda.nombre)
    imprimir(segunda.edad)

    // Recorrer.
    para (i, f en lista) {
        imprimir(f.nombre)
    }

    lista.soltar()
    imprimir(lista.largo())
    retornar 0
}
