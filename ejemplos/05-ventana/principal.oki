// Una ventana con una interfaz colocada por el módulo de diseño.
usar ventana
usar diseno
usar accesibilidad

funcion principal() -> entero {
    variable titulo = "Nooki — ejemplo de ventana" + ""
    variable v = ventana.abrir(&titulo, 480, 320)

    si (v == 0) {
        imprimir("sin entorno grafico")
        retornar 0
    }

    ventana.limpiar(v, 0x1E1E2E)

    variable col = nuevo columna { x: 24, y: 24, ancho: 432, alto: 272, usado: 0, separacion: 12 }

    variable bienvenida = "Hola desde Nooki" + ""
    ventana.escribir_texto(v, 24, col.hueco(20), &bienvenida, 0xF5E0DC)

    variable subtitulo = "ventana, dibujo y layout" + ""
    ventana.escribir_texto(v, 24, col.hueco(18), &subtitulo, 0x9399B2)

    variable fila_botones = nuevo fila { x: 24, y: 96, ancho: 432, alto: 48, usado: 0, separacion: 12 }
    variable color_boton = 0x89B4FA
    variable color_texto = accesibilidad.texto_sobre(color_boton)
    variable estado_foco = nuevo foco { indice: 0, total: 3 }

    variable i = 0
    mientras (i < 3) {
        variable x = 24 + fila_botones.hueco(120)
        ventana.rectangulo(v, x, 96, 120, 48, color_boton)
        variable etiqueta = "Boton" + ""
        ventana.escribir_texto(v, x + 16, 96 + 24, &etiqueta, color_texto)

        // El control con el foco lleva un contorno de 2 píxeles.
        si (estado_foco.es_actual(i)) {
            variable color_foco = 0xF9E2AF
            ventana.rectangulo(v, x - 2, 96 - 2, 124, 2, color_foco)
            ventana.rectangulo(v, x - 2, 96 + 48, 124, 2, color_foco)
            ventana.rectangulo(v, x - 2, 96, 2, 48, color_foco)
            ventana.rectangulo(v, x + 120, 96, 2, 48, color_foco)
        }
        i = i + 1
    }

    variable ancho_barra = 432
    ventana.rectangulo(v, 24, 200, ancho_barra, 16, 0x313244)
    variable relleno = diseno.repartir(ancho_barra, 3)
    ventana.rectangulo(v, 24, 200, relleno, 16, 0xA6E3A1)

    ventana.presentar(v)

    variable fotogramas = 0
    mientras (ventana.viva(v) && fotogramas < 120) {
        si (ventana.siguiente_evento(v) == 1) {
            romper
        }
        ventana.pausa(16)
        fotogramas = fotogramas + 1
    }

    ventana.cerrar(v)
    imprimir("ventana cerrada")
    retornar 0
}
